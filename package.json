{
  "name": "dsh-think-zh",
  "version": "1.0.0",
  "description": "让 DeepSeek Harness 用简体中文思考",
  "author": "RainnnQAQ",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RainnnQAQ/dsh-think-zh.git"
  },
  "homepage": "https://github.com/RainnnQAQ/dsh-think-zh#readme",
  "bugs": {
    "url": "https://github.com/RainnnQAQ/dsh-think-zh/issues"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "meta": {
    "title": "中文思考",
    "description": "让 DeepSeek Harness 用简体中文思考"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis-plugin",
    "thinking",
    "reasoning",
    "chinese",
    "i18n",
    "中文思考"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "dsh": ">=0.1.7-rc.2",
    "node": ">=18"
  },
  "scripts": {
    "test": "node index.js --selftest",
    "test:probe": "node test/probe.mjs",
    "test:e2e": "node test/e2e.mjs",
    "install:profile": "node install.mjs"
  },
  "license": "MIT"
}
